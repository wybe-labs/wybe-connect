{
  "description": "wybe-connect for Codex: SessionStart injects the standing instruction and the node's cached open questions; Stop and PreCompact flush the redacted rollout delta to the node (or the local queue); SessionEnd only queues (Codex caps it at 3 s). Every hook exits 0 whatever happens.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/session-start.js\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/flush.js\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/flush.js\"",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/flush.js\" --offline",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
