{
  "description": "wybe-connect for Codex: SessionStart injects the standing instruction, the node's cached open questions and a background-distil problem (once per kind); Stop and PreCompact note the session for the background distil (codex exec) and send nothing themselves; SessionEnd only notes (Codex caps it at 3 s). bridge.js is the session bridge: it starts the session's detached poller, which queues a task from the person's Wybe colleague into the live session (codex queue), settles the task's result at Stop, and hands over a notice that could not be queued as a Stop block. Every hook exits 0 whatever happens.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/session-start.js\"",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/bridge.js\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/flush.js\"",
            "timeout": 30
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/bridge.js\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/flush.js\"",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/flush.js\" --offline",
            "timeout": 3
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/bridge.js\"",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
