{
  "description": "wybe-connect for Codex: SessionStart injects the standing instruction, the node's cached open questions and a background-distil problem (once per kind); Stop and PreCompact note the session for the background distil (codex exec) and send nothing themselves; SessionEnd only notes (Codex caps it at 3 s). Every hook exits 0 whatever happens.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/session-start.js\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/flush.js\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/flush.js\"",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/flush.js\" --offline",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
