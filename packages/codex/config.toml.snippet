# Add to ~/.codex/config.toml (or run: codex mcp add wybe --url https://dittfirma.wybe.me/mcp),
# with your own address, then sign in once: codex mcp login wybe
# Format: [mcp_servers.<name>] with `url` for a Streamable HTTP server
# (https://learn.chatgpt.com/docs/extend/mcp?surface=cli, read 2026-09-29).

[mcp_servers.wybe]
url = "https://dittfirma.wybe.me/mcp"
