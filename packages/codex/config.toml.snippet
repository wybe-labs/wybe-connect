# The manual fallback for the plugin's own MCP server (mcp.json does the same when the plugin is
# installed). Add to ~/.codex/config.toml, with the path to this plugin's directory. The server
# uses the grant bin/connect.js (or its own `connect` tool) stored: no second sign-in.
# Format: [mcp_servers.<name>] with `command` and `args` for a stdio server
# (https://learn.chatgpt.com/docs/extend/mcp?surface=cli).

[mcp_servers.wybe]
command = "node"
args = ["/path/to/wybe-connect/packages/codex/bin/mcp-proxy.js"]
